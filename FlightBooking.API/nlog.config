<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="logs/nlog-internal.log">

  <targets>
    <!-- קובץ יומי: logs/2026-11-09.log -->
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-method} ${aspnet-request-url}|${message}${onexception:${newline}${exception:format=tostring}}"
            encoding="utf-8"
            keepFileOpen="false"
            archiveEvery="Day"
            maxArchiveFiles="30" />

    <!-- קונסולה -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- כל המידע והלאה לקובץ -->
    <logger name="*" minlevel="Info" writeTo="file" />
    <!-- בקונסולה: אזהרות ומעלה -->
    <logger name="*" minlevel="Warn" writeTo="console" />
  </rules>
</nlog>